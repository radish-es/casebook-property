{
  "$schema": "https://frontmatter.codes/frontmatter.schema.json",
  "frontMatter.taxonomy.contentTypes": [
    {
      "name": "default",
      "pageBundle": false,
      "previewPath": null,
      "fields": [
        {
          "title": "Title",
          "name": "title",
          "type": "string"
        },
        {
          "title": "Description",
          "name": "description",
          "type": "string"
        },
        {
          "title": "Publishing date",
          "name": "date",
          "type": "datetime",
          "default": "{{now}}",
          "isPublishDate": true
        },
        {
          "title": "Content preview",
          "name": "preview",
          "type": "image"
        },
        {
          "title": "Is in draft",
          "name": "draft",
          "type": "draft"
        },
        {
          "title": "Tags",
          "name": "tags",
          "type": "tags"
        },
        {
          "title": "Categories",
          "name": "categories",
          "type": "categories"
        }
      ]
    },
    {
      "name": "case",
      "pageBundle": false,
      "fields": [
        {
          "title": "Type",
          "name": "type",
          "type": "string"
        },
        {
          "title": "Title",
          "name": "title",
          "type": "string"
        },
        {
          "title": "Short Name",
          "name": "short",
          "type": "string"
        },
        {
          "title": "Case Reporter",
          "name": "reporter",
          "type": "string"
        },
        {
          "title": "Case Year",
          "name": "year",
          "type": "number"
        },
        {
          "title": "Facts",
          "name": "facts",
          "type": "string"
        },
        {
          "title": "Issue",
          "name": "issue",
          "type": "string"
        },
        {
          "title": "Held",
          "name": "held",
          "type": "string"
        },
        {
          "title": "Description",
          "name": "description",
          "type": "string"
        },
        {
          "title": "Public Domain?",
          "name": "public",
          "type": "boolean"
        },
        {
          "title": "Doctrines",
          "name": "doctrines",
          "type": "choice",
          "choices": [
            "covenants"
          ]
        },
        {
          "title": "Weight",
          "name": "weight",
          "type": "number"
        },
        {
          "title": "Hidden in Hugo Book",
          "name": "bookHidden",
          "type": "boolean"
        }
      ]
    },
    {
      "name": "lesson",
      "pageBundle": false,
      "fields": [
        {
          "title": "Type",
          "name": "type",
          "type": "string"
        },
        {
          "title": "Title",
          "name": "title",
          "type": "string"
        },
        {
          "title": "Short",
          "name": "short",
          "type": "string"
        },
        {
          "title": "Description",
          "name": "description",
          "type": "string"
        },
        {
          "title": "Weight",
          "name": "weight",
          "type": "number"
        },
        {
          "title": "Class Dates",
          "name": "classdate",
          "type": "string"
        },
        {
          "title": "Header Image",
          "name": "image",
          "type": "image"
        },
        {
          "title": "Image Caption",
          "name": "imgcaption",
          "type": "string"
        },
        {
          "title": "Lesson Objectives",
          "name": "objectives",
          "type": "block",
          "fieldGroup": [
            "objectives_group"
          ]
        },
        {
          "title": "Assigned Materials",
          "name": "materials",
          "type": "list"
        }
      ]
    },
    {
      "name": "problem",
      "pageBundle": false,
      "fields": [
        {
          "title": "Title",
          "name": "title",
          "type": "string"
        },
        {
          "title": "Short Title",
          "name": "short",
          "type": "string"
        },
        {
          "title": "Type",
          "name": "type",
          "type": "string"
        },
        {
          "title": "Description",
          "name": "description",
          "type": "string"
        },
        {
          "title": "Header Image",
          "name": "image",
          "type": "image"
        },
        {
          "title": "Image Caption",
          "name": "imgcaption",
          "type": "string"
        },
        {
          "title": "Weight",
          "name": "weight",
          "type": "number"
        }
      ]
    }
  ],
  "frontMatter.framework.id": "hugo",
  "frontMatter.content.publicFolder": "static",
  "frontMatter.preview.host": "http://localhost:1313",
  "frontMatter.content.pageFolders": [
    {
      "title": "imgs",
      "path": "[[workspace]]/static/imgs"
    },
    {
      "title": "admin",
      "path": "[[workspace]]/content/admin"
    },
    {
      "title": "lessons",
      "path": "[[workspace]]/content/units/lessons"
    },
    {
      "title": "problems",
      "path": "[[workspace]]/content/units/problems"
    },
    {
      "title": "covenants",
      "path": "[[workspace]]/content/casebook/covenants"
    },
    {
      "title": "expropriation",
      "path": "[[workspace]]/content/casebook/expropriation"
    },
    {
      "title": "indigenous",
      "path": "[[workspace]]/content/casebook/indigenous"
    },
    {
      "title": "nuisance",
      "path": "[[workspace]]/content/casebook/nuisance"
    },
    {
      "title": "other",
      "path": "[[workspace]]/content/casebook/other"
    },
    {
      "title": "possession",
      "path": "[[workspace]]/content/casebook/possession"
    },
    {
      "title": "public-land",
      "path": "[[workspace]]/content/casebook/public-land"
    },
    {
      "title": "registration",
      "path": "[[workspace]]/content/casebook/registration"
    },
    {
      "title": "tenure-estates",
      "path": "[[workspace]]/content/casebook/tenure-estates"
    },
    {
      "title": "trusts",
      "path": "[[workspace]]/content/casebook/trusts"
    },
    {
      "title": "zoning",
      "path": "[[workspace]]/content/casebook/zoning"
    }
  ],
  "frontMatter.git.enabled": false,
  "frontMatter.taxonomy.fieldGroups": [
    {
      "id": "objectives_group",
      "fields": [
        {
          "title": "Objective",
          "name": "objective",
          "type": "string"
        }
      ]
    }
  ]
}