{
  "$schema": "https://frontmatter.codes/frontmatter.schema.json",
  "frontMatter.taxonomy.contentTypes": [
    {
      "name": "default",
      "pageBundle": false,
      "previewPath": null,
      "fields": [
        {
        "title": "General",
        "name": "general",
        "type": "fieldCollection",
        "fieldGroup": "generalFields"
        }
      ]
    },
    {
      "name": "case",
      "pageBundle": false,
      "fields": [
        {
        "title": "General",
        "name": "general",
        "type": "fieldCollection",
        "fieldGroup": "generalFields"
        },
        {
        "title": "Casebook Content",
        "name": "casebook",
        "type": "fieldCollection",
        "fieldGroup": "casebookFields"
        },
        {
          "title": "Case Reporter",
          "name": "reporter",
          "type": "string"
        },
        {
          "title": "Case Year",
          "name": "year",
          "type": "number"
        },
        {
          "title": "Facts",
          "name": "facts",
          "type": "string"
        },
        {
          "title": "Issue",
          "name": "issue",
          "type": "string"
        },
        {
          "title": "Held",
          "name": "held",
          "type": "string"
        }
      ]
    },
    {
      "name": "statute",
      "pageBundle": false,
      "fields": [
        {
        "title": "General",
        "name": "general",
        "type": "fieldCollection",
        "fieldGroup": "generalFields"
        },
        {
        "title": "Casebook Content",
        "name": "casebook",
        "type": "fieldCollection",
        "fieldGroup": "casebookFields"
        },
        {
          "title": "Reporter",
          "name": "reporter",
          "type": "string"
        },
        {
          "title": "Sources",
          "name": "sources",
          "fields": [
            {
              "title": "Source Name",
              "name": "source_name",
              "type": "string"
            },
            {
              "title": "Source URL",
              "name": "source_url",
              "type": "string"
            },
            {
              "title": "License",
              "name": "license",
              "type": "string"
            },
            {
              "title": "Attribution",
              "name": "attribution",
              "type": "string"
            }
          ]
        }
      ]
    },
    {
      "name": "secondary",
      "pageBundle": false,
      "fields": [
        {
        "title": "General",
        "name": "general",
        "type": "fieldCollection",
        "fieldGroup": "generalFields"
        },
        {
        "title": "Casebook Content",
        "name": "casebook",
        "type": "fieldCollection",
        "fieldGroup": "casebookFields"
        },
        {
          "title": "Source",
          "name": "source",
          "type": "string"
        },
      ]
    },
    {
      "name": "lesson",
      "pageBundle": false,
      "fields": [
        {
        "title": "General",
        "name": "general",
        "type": "fieldCollection",
        "fieldGroup": "generalFields"
        },
        {
          "title": "Class Dates",
          "name": "classdate",
          "type": "string"
        },
        {
        "title": "Image",
        "name": "image",
        "type": "fieldCollection",
        "fieldGroup": "imgFields"
        },
        {
          "title": "Lesson Objectives",
          "name": "objectives",
          "type": "block",
          "fieldGroup": [
            "objectives_group"
          ]
        },
        {
          "title": "Assigned Materials",
          "name": "materials",
          "type": "list"
        }
      ]
    },
    {
      "name": "problem",
      "pageBundle": false,
      "fields": [
        {
        "title": "General",
        "name": "general",
        "type": "fieldCollection",
        "fieldGroup": "generalFields"
        },
        {
        "title": "Image",
        "name": "image",
        "type": "fieldCollection",
        "fieldGroup": "imgFields"
        }
      ]
    }
  ],
  "frontMatter.framework.id": "hugo",
  "frontMatter.content.publicFolder": "static",
  "frontMatter.preview.host": "http://localhost:1313",
  "frontMatter.content.pageFolders": [
    {
      "title": "imgs",
      "path": "[[workspace]]/static/imgs"
    },
    {
      "title": "admin",
      "path": "[[workspace]]/content/admin"
    },
    {
      "title": "lessons",
      "path": "[[workspace]]/content/units/lessons"
    },
    {
      "title": "problems",
      "path": "[[workspace]]/content/units/problems"
    },
    {
      "title": "covenants",
      "path": "[[workspace]]/content/casebook/covenants"
    },
    {
      "title": "expropriation",
      "path": "[[workspace]]/content/casebook/expropriation"
    },
    {
      "title": "indigenous",
      "path": "[[workspace]]/content/casebook/indigenous"
    },
    {
      "title": "nuisance",
      "path": "[[workspace]]/content/casebook/nuisance"
    },
    {
      "title": "other",
      "path": "[[workspace]]/content/casebook/other"
    },
    {
      "title": "possession",
      "path": "[[workspace]]/content/casebook/possession"
    },
    {
      "title": "public-land",
      "path": "[[workspace]]/content/casebook/public-land"
    },
    {
      "title": "registration",
      "path": "[[workspace]]/content/casebook/registration"
    },
    {
      "title": "tenure-estates",
      "path": "[[workspace]]/content/casebook/tenure-estates"
    },
    {
      "title": "trusts",
      "path": "[[workspace]]/content/casebook/trusts"
    },
    {
      "title": "zoning",
      "path": "[[workspace]]/content/casebook/zoning"
    }
  ],
  "frontMatter.git.enabled": false,
  "frontMatter.taxonomy.fieldGroups": [
    {
      "id": "objectives_group",
      "fields": [
        {
          "title": "Objective",
          "name": "objective",
          "type": "string"
        }
      ]
    },
    {
    "id": "generalFields",
    "fields": [
        {
          "title": "Type",
          "name": "type",
          "type": "string"
        },
        {
          "title": "Title",
          "name": "title",
          "type": "string",
          "single": true
        },
        {
            "title": "Short Title",
            "name": "short",
            "type": "string"
        },
        {
          "title": "Description",
          "name": "description",
          "type": "string"
        },
        {
            "title": "Weight",
            "name": "weight",
            "type": "number"
        },
        {
            "title": "Draft",
            "name": "draft",
            "type": "boolean"
        }
      ]
    },
    {
    "id": "casebookFields",
    "fields": [
        {
          "title": "Public Domain?",
          "name": "public",
          "type": "boolean"
        },
        {
          "title": "Doctrines",
          "name": "doctrines",
          "type": "list"
        },
        {
          "title": "Hidden in Hugo Book",
          "name": "bookHidden",
          "type": "boolean"
        }
      ]
    },
    {
    "id": "imgFields",
    "fields": [
        {
          "title": "Header Image",
          "name": "image",
          "type": "image"
        },
        {
          "title": "Image Caption",
          "name": "imgcaption",
          "type": "string"
        }
      ]
    }
  ]
}